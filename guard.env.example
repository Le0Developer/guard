DOMAIN=https://auth.example.com
# 32 random bytes, unpadded base64url. Keep this key with backups.
MFA_ENCRYPTION_KEY=
AUDIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# PASSWORD_DISABLED=false
# ACCESS_LOG_EXPORT_URL=https://collector.example.com/events
# ACCESS_LOG_EXPORT_TOKEN=
# AUDIT_EVENT_REPORTS_PER_MINUTE=600

# Optional branding. Icon path is inside the container (mount it read-only).
# BRAND_NAME=Company Login
# BRAND_ICON_FILE=/branding/icon.svg
